# ------------------------------------------------------------
# Eventra — environment settings
# Copy this file to ".env" and replace every placeholder.
# Never commit your real .env file.
# ------------------------------------------------------------

# Port on your laptop where the website will be available (http://localhost:8080)
WEB_PORT=8080

# ---- Database (PostgreSQL) ----
DB_HOST=db
DB_PORT=5432
DB_NAME=eventra
DB_USER=eventra_user
DB_PASSWORD=change-me-strong-db-password
# Set to true when the database requires SSL (for example Amazon RDS)
DB_SSL=false

# ---- App / API ----
NODE_ENV=production
PORT=4000
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins (only needed if the API is called from another domain)
CORS_ORIGIN=http://localhost:8080

# ---- Admin account (created/updated automatically on start) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Load sample events on first start when the events table is empty (true/false)
SEED_SAMPLE_DATA=true
